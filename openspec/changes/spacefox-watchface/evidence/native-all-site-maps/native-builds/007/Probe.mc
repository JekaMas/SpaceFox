import Toybox.Application;import Toybox.Graphics;import Toybox.Lang;import Toybox.System;import Toybox.Timer;import Toybox.WatchUi;
(:typecheck(false)) class SourceStore {var refs;function initialize(r){refs=r;}function read(key){for(var i=0;i<refs.size();i+=1){if(key.equals("sf.obj."+refs[i][0])){return WatchUi.loadResource(refs[i][2])["raw"];}}return null;}function write(k,v){}function remove(k){}}
(:typecheck(false)) class SiteBatchView extends WatchUi.View {
var index=0;var stage=0;var decoder;var renderer;var rich;var timer;var settings;var context;var row;
function siteCase(i){if(i==0){return [Rez.JsonData.SiteMeta0,[Rez.JsonData.Obj0_0,Rez.JsonData.Obj0_1,Rez.JsonData.Obj0_2,Rez.JsonData.Obj0_3,Rez.JsonData.Obj0_4,Rez.JsonData.Obj0_5,Rez.JsonData.Obj0_6,Rez.JsonData.Obj0_7,Rez.JsonData.Obj0_8,Rez.JsonData.Obj0_9,Rez.JsonData.Obj0_10,Rez.JsonData.Obj0_11,Rez.JsonData.Obj0_12,Rez.JsonData.Obj0_13,Rez.JsonData.Obj0_14,Rez.JsonData.Obj0_15]];} return null;}
function initialize(){View.initialize();renderer=new SceneRenderer(null);settings=new SceneSettings(null);timer=new Timer.Timer();}
function next(){if(stage!=3){return;}index+=1;stage=0;row=null;rich=null;renderer.downloaded=null;WatchUi.requestUpdate();}
function onUpdate(dc){if(index>=1){System.println("BATCH_COMPLETE count="+index);System.exit();return;}
if(stage==0){var spec=siteCase(index);row=WatchUi.loadResource(spec[0]);var inputs=row["shards"];if(inputs.size()==0){context=new SceneContext({"id"=>row["id"],"site"=>row["name"]});renderer.prepare(context,settings);renderer.downloaded=null;stage=2;}else{var refs=[];var desc={"canvas"=>[390,390],"channels"=>3,"pixelSha256"=>row["pixel"],"shards"=>[]};for(var i=0;i<inputs.size();i+=1){refs.add([inputs[i][0],inputs[i][1],spec[1][i]]);desc["shards"].add(inputs[i]);}decoder=new NativeSfrDecoder(new SourceStore(refs),desc);stage=1;}}
if(stage==1){if(!decoder.step()){WatchUi.requestUpdate();return;}rich=new NativeSfrRenderer();rich.mapBitmap=decoder.bitmap;decoder=null;rich.scene={"position"=>true};context=new SceneContext({"id"=>row["id"],"site"=>row["name"]});renderer.prepare(context,settings);renderer.downloaded=rich;stage=2;}
if(stage==2){renderer.active(dc,new ClockSnapshot("08:08","T- 16:18:18"),settings,{},new Fitness(),0.0);var tag=index+7;for(var bit=0;bit<8;bit+=1){dc.setColor((tag&(1<<bit))!=0?Graphics.COLOR_WHITE:Graphics.COLOR_BLACK,Graphics.COLOR_TRANSPARENT);dc.fillRectangle(124+bit*7,360,6,8);}System.println("SITE_FRAME index="+tag+" id="+row["id"]+" digest="+row["pixel"]+" heap="+System.getSystemStats().totalMemory);stage=3;}}
}
(:typecheck(false)) class CaptureDelegate extends WatchUi.InputDelegate {var view;function initialize(v){InputDelegate.initialize();view=v;}function onKey(evt){view.next();return true;}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {function initialize(){AppBase.initialize();NativeMetrics.ownerTag="75cf204525b24e3ab92a2b490f3ac5a0|native-build-007|ef77876425e4";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);NativeMetrics.enabled=true;}function getInitialView(){var v=new SiteBatchView();return [v,new CaptureDelegate(v)];}}
