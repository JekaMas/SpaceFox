(:typecheck(false)) class SiteBatchView extends WatchUi.View {
var index=0;var stage=0;var decoder;var renderer;var rich;var timer;var settings;var context;var row;
function siteCase(i){if(i==0){return [Rez.JsonData.SiteMeta0,[]];}if(i==1){return [Rez.JsonData.SiteMeta1,[]];}if(i==2){return [Rez.JsonData.SiteMeta2,[]];}if(i==3){return [Rez.JsonData.SiteMeta3,[]];}if(i==4){return [Rez.JsonData.SiteMeta4,[]];}if(i==5){return [Rez.JsonData.SiteMeta5,[]];}if(i==6){return [Rez.JsonData.SiteMeta6,[]];}if(i==7){return [Rez.JsonData.SiteMeta7,[]];}if(i==8){return [Rez.JsonData.SiteMeta8,[]];}if(i==9){return [Rez.JsonData.SiteMeta9,[]];}if(i==10){return [Rez.JsonData.SiteMeta10,[]];}if(i==11){return [Rez.JsonData.SiteMeta11,[]];}if(i==12){return [Rez.JsonData.SiteMeta12,[]];}if(i==13){return [Rez.JsonData.SiteMeta13,[]];}if(i==14){return [Rez.JsonData.SiteMeta14,[]];} return null;}
function initialize(){View.initialize();renderer=new SceneRenderer(null);settings=new SceneSettings(null);timer=new Timer.Timer();}
function next(){if(stage!=3){return;}index+=1;stage=0;row=null;rich=null;renderer.downloaded=null;WatchUi.requestUpdate();}
function onUpdate(dc){if(index>=15){System.println("BATCH_COMPLETE count="+index);System.exit();return;}
if(stage==0){var spec=siteCase(index);row=WatchUi.loadResource(spec[0]);var inputs=row["shards"];if(inputs.size()==0){context=new SceneContext({"id"=>row["id"],"site"=>row["name"]});renderer.prepare(context,settings);renderer.downloaded=null;stage=2;}else{var refs=[];var desc={"canvas"=>[390,390],"channels"=>3,"pixelSha256"=>row["pixel"],"shards"=>[]};for(var i=0;i<inputs.size();i+=1){refs.add([inputs[i][0],inputs[i][1],spec[1][i]]);desc["shards"].add(inputs[i]);}decoder=new NativeSfrDecoder(new SourceStore(refs),desc);stage=1;}}
if(stage==1){if(!decoder.step()){WatchUi.requestUpdate();return;}rich=new NativeSfrRenderer();rich.mapBitmap=decoder.bitmap;decoder=null;rich.scene={"position"=>true};context=new SceneContext({"id"=>row["id"],"site"=>row["name"]});renderer.prepare(context,settings);renderer.downloaded=rich;stage=2;}
if(stage==2){renderer.active(dc,new ClockSnapshot("08:08","T- 16:18:18"),settings,{},new Fitness(),0.0);var tag=index+209;for(var bit=0;bit<8;bit+=1){dc.setColor((tag&(1<<bit))!=0?Graphics.COLOR_WHITE:Graphics.COLOR_BLACK,Graphics.COLOR_TRANSPARENT);dc.fillRectangle(124+bit*7,360,6,8);}System.println("SITE_FRAME index="+tag+" id="+row["id"]+" digest="+row["pixel"]+" heap="+System.getSystemStats().totalMemory);stage=3;}}
}
