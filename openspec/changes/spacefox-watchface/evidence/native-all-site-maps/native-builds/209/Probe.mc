(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {function initialize(){AppBase.initialize();NativeMetrics.ownerTag="6c38d83bac134db1ac8542b5d5599734|native-build-209|ef77876425e4";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);NativeMetrics.enabled=true;}function getInitialView(){var v=new SiteBatchView();return [v,new CaptureDelegate(v)];}}
