import Toybox.Lang;import Toybox.System;import Toybox.Test;import Toybox.WatchUi;
(:test,:typecheck(false)) class D03MapStore {function read(key){if(key.equals("sf.obj.2a09c8ea59ca32d5ee8ea4e5520682de56a7539b86e434b804f96ffeca0cecd6")){return WatchUi.loadResource(Rez.JsonData.D03MapShard0)["raw"];}if(key.equals("sf.obj.4d28962616ea3056f6ce6fde40f6904f9d9dee2e657f67f988b4eaa4d31e8e92")){return WatchUi.loadResource(Rez.JsonData.D03MapShard1)["raw"];}if(key.equals("sf.obj.671a4b8da3f5c272f41a709b7b72285ee96247eed72d4b3c521bc13884bb6153")){return WatchUi.loadResource(Rez.JsonData.D03MapShard2)["raw"];}if(key.equals("sf.obj.eeaefa0a3910f493ba1409eca38c0473fa68b6b99da810696788b8338b01fddd")){return WatchUi.loadResource(Rez.JsonData.D03MapShard3)["raw"];}if(key.equals("sf.obj.180d4d090c41fddf2fd1d79dd46405bbf9d13569ec151440658ec50208b5eb5b")){return WatchUi.loadResource(Rez.JsonData.D03MapShard4)["raw"];}if(key.equals("sf.obj.0936caabf3d961df403c05a1a35a5436d5842c45de0077cfd7053118a6e7ca29")){return WatchUi.loadResource(Rez.JsonData.D03MapShard5)["raw"];}if(key.equals("sf.obj.db31d9ab634adaa54e03c7c96a2eee50064466b0565444a8bda1145a520ac301")){return WatchUi.loadResource(Rez.JsonData.D03MapShard6)["raw"];}if(key.equals("sf.obj.653939e2711ce529f39617eb84040f245960720925e27e70d270247940553e3a")){return WatchUi.loadResource(Rez.JsonData.D03MapShard7)["raw"];}if(key.equals("sf.obj.07924fc156dcfcd1725e9dce51567b9d04b13933fe56f89a0255b3ffcc914580")){return WatchUi.loadResource(Rez.JsonData.D03MapShard8)["raw"];}if(key.equals("sf.obj.697b580f41521ace59315e84264ddbfb4dee9d77b50f3d2e256ad10b7a6a56cf")){return WatchUi.loadResource(Rez.JsonData.D03MapShard9)["raw"];}if(key.equals("sf.obj.9107867a46a828266cdc4669352d110734f23c385ef52bc1ca7073709bb415ee")){return WatchUi.loadResource(Rez.JsonData.D03MapShard10)["raw"];}return null;}}
(:test,:typecheck(false)) function display03RealMapDecode(logger){var d=WatchUi.loadResource(Rez.JsonData.D03MapDescriptor);var start=System.getTimer();var decoder=new NativeSfrDecoder(new D03MapStore(),d);var steps=0;while(!decoder.step()){steps+=1;Test.assert(steps<2000);}Test.assert(decoder.done&&decoder.bitmap!=null&&decoder.outlineBitmap!=null);logger.debug("REAL_MAP_DECODE launch=ll2:launch:ef9850ad-1096-425b-9d27-f7bbd186e61a sourceSite=ll2:site:29 checksum=verified outline=true steps="+steps+" elapsedMs="+(System.getTimer()-start));return true;}
