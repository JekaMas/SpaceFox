import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.WatchUi;
(:typecheck(false)) class NegativeView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step(dc);}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {
 var store;var cache;var immutable;var stage=0;var pos=0;var objects=[Rez.JsonData.ObjA0,Rez.JsonData.ObjA1,Rez.JsonData.ObjA2,Rez.JsonData.ObjA3,Rez.JsonData.ObjA4,Rez.JsonData.ObjA5,Rez.JsonData.ObjA6,Rez.JsonData.ObjA7,Rez.JsonData.ObjA8,Rez.JsonData.ObjA9,Rez.JsonData.ObjA10,Rez.JsonData.ObjA11,Rez.JsonData.ObjA12,Rez.JsonData.ObjA13,Rez.JsonData.ObjA14,Rez.JsonData.ObjA15,Rez.JsonData.ObjA16,Rez.JsonData.ObjA17];var build;var prior;var missing;var priorRenderer;
 function initialize(){AppBase.initialize();System.println("SFR_PROBE owner=c0f4547b91f3446c9c73fd30f62fbd6e|fallback-draw|f46511d66294");}
 function ensure(ok,msg){if(!ok){System.println("NEG_FAIL "+msg);throw new Lang.InvalidValueException(msg);}}
 function getInitialView(){store=new NativeStore();cache=new NativeCache("https://negative.invalid",store);immutable=new NativeImmutable(store);ensure(store.read("sf.commit")==null,"fresh");return [new NegativeView(self)];}
 function again(){WatchUi.requestUpdate();}
 function step(dc){
 if(stage==0||stage==2){if(pos<objects.size()){var item=WatchUi.loadResource(objects[pos]);ensure(immutable.put(item["ref"],item["raw"]),"seed "+pos);pos+=1;again();return;}if(stage==0){ensure(cache.accept(WatchUi.loadResource(Rez.JsonData.FeedA)["raw"],1794551192l),"accept A");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage=1;}else{missing=WatchUi.loadResource(Rez.JsonData.ObjB5);ensure(!immutable.put(missing["ref"],missing["raw"]+"x"),"reject corrupted bytes");ensure(immutable.raw(missing["ref"])==null,"missing remains absent");ensure(cache.accept(WatchUi.loadResource(Rez.JsonData.FeedB)["raw"],1794551192l),"accept fresh B schedule");var view=new SpaceFoxView(new WatchClock(),new ScheduleState(null,"empty"));var old=priorRenderer;ensure(old.selectionHash.equals("426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70")&&old.bitmap!=null,"actual prior bitmap");view.downloaded=old;view.setPacket(cache.packet);priorRenderer=null;old=null;view.onLayout(dc);view.onExitSleep();view.onUpdate(dc);ensure(view.renderer.downloaded==null&&view.context.point!=null&&view.context.point[1]==26.99677&&view.renderer.pin==false,"B fallback point/projection");System.println("FALLBACK_DRAW Bcontext=true Bpoint=26.99677 matchingProjection=false marker=false oldRaster=false");stage=99;return;ensure(view.downloaded==null&&view.context.launchId.equals("ll2:launch:0f867f0c-5422-4d44-93b8-d7faaae7019b"),"no old bitmap under B");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage=3;}again();return;}
 if(stage==1){if(!build.step()){again();return;}priorRenderer=build.result;ensure(priorRenderer.bitmap!=null&&priorRenderer.mapBitmap!=null,"A bitmap");prior=store.read("sf.raster.active")["selectionHash"];ensure(prior.equals("426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70"),"A active");build=null;objects=[Rez.JsonData.ObjB0,Rez.JsonData.ObjB1,Rez.JsonData.ObjB2,Rez.JsonData.ObjB3,Rez.JsonData.ObjB4,Rez.JsonData.ObjB6,Rez.JsonData.ObjB7,Rez.JsonData.ObjB8,Rez.JsonData.ObjB9,Rez.JsonData.ObjB10,Rez.JsonData.ObjB11,Rez.JsonData.ObjB12,Rez.JsonData.ObjB13,Rez.JsonData.ObjB14,Rez.JsonData.ObjB15,Rez.JsonData.ObjB16,Rez.JsonData.ObjB17];pos=0;stage=2;again();return;}
 if(stage==3){var refused=false;try{build.step();}catch(ex){refused=true;System.println("NEG_EXPECTED missingObject="+ex.getErrorMessage());}if(!refused){again();return;}ensure(store.read("sf.raster.active")["selectionHash"].equals(prior),"partial activated");ensure(cache.packet.document["publisher"]["generation"]==2&&cache.packet.validation==1794551192l,"B source facts");ensure(immutable.put(missing["ref"],missing["raw"]),"retry missing object");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage=4;again();return;}
 if(stage==4){if(!build.step()){again();return;}ensure(build.result.selectionHash.equals("7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de")&&store.read("sf.raster.active")["selectionHash"].equals("7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de"),"retry B active");ensure(store.read("sf.raster.recovery")["selectionHash"].equals(prior),"A recovery");System.println("NEG_COMPLETE corruptRejected=true missingRefused=true priorPointerPreserved=true freshBContext=true noOldBitmap=true retryB=true recoveryA=true actualOldBitmapCleared=true");stage=99;System.exit();}
