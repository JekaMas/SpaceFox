import Toybox.Lang;import Toybox.System;import Toybox.Test;import Toybox.WatchUi;
(:typecheck(false)) class PeerMapStore {function read(key){if(key.equals("sf.obj.2a09c8ea59ca32d5ee8ea4e5520682de56a7539b86e434b804f96ffeca0cecd6")){return WatchUi.loadResource(Rez.JsonData.D03MapShard0)["raw"];}if(key.equals("sf.obj.4d28962616ea3056f6ce6fde40f6904f9d9dee2e657f67f988b4eaa4d31e8e92")){return WatchUi.loadResource(Rez.JsonData.D03MapShard1)["raw"];}if(key.equals("sf.obj.671a4b8da3f5c272f41a709b7b72285ee96247eed72d4b3c521bc13884bb6153")){return WatchUi.loadResource(Rez.JsonData.D03MapShard2)["raw"];}if(key.equals("sf.obj.eeaefa0a3910f493ba1409eca38c0473fa68b6b99da810696788b8338b01fddd")){return WatchUi.loadResource(Rez.JsonData.D03MapShard3)["raw"];}if(key.equals("sf.obj.180d4d090c41fddf2fd1d79dd46405bbf9d13569ec151440658ec50208b5eb5b")){return WatchUi.loadResource(Rez.JsonData.D03MapShard4)["raw"];}if(key.equals("sf.obj.0936caabf3d961df403c05a1a35a5436d5842c45de0077cfd7053118a6e7ca29")){return WatchUi.loadResource(Rez.JsonData.D03MapShard5)["raw"];}if(key.equals("sf.obj.db31d9ab634adaa54e03c7c96a2eee50064466b0565444a8bda1145a520ac301")){return WatchUi.loadResource(Rez.JsonData.D03MapShard6)["raw"];}if(key.equals("sf.obj.653939e2711ce529f39617eb84040f245960720925e27e70d270247940553e3a")){return WatchUi.loadResource(Rez.JsonData.D03MapShard7)["raw"];}if(key.equals("sf.obj.07924fc156dcfcd1725e9dce51567b9d04b13933fe56f89a0255b3ffcc914580")){return WatchUi.loadResource(Rez.JsonData.D03MapShard8)["raw"];}if(key.equals("sf.obj.697b580f41521ace59315e84264ddbfb4dee9d77b50f3d2e256ad10b7a6a56cf")){return WatchUi.loadResource(Rez.JsonData.D03MapShard9)["raw"];}if(key.equals("sf.obj.9107867a46a828266cdc4669352d110734f23c385ef52bc1ca7073709bb415ee")){return WatchUi.loadResource(Rez.JsonData.D03MapShard10)["raw"];}return null;}}

import Toybox.Application; import Toybox.Graphics; import Toybox.Timer;
(:typecheck(false)) class TimerView extends WatchUi.WatchFace {var timer;var decoder;var started;var steps=0;var maxRows=0;var maxSlice=0;function initialize(){WatchFace.initialize();}function onShow(){decoder=new NativeSfrDecoder(new PeerMapStore(),WatchUi.loadResource(Rez.JsonData.D03MapDescriptor));started=System.getTimer();timer=new Timer.Timer();timer.start(method(:tick),50,true);System.println("TIMED_MAP_START intervalMs=50");}function tick(){var before=decoder.y;var slice=System.getTimer();steps+=1;var done=decoder.step();var rows=decoder.y-before;var took=System.getTimer()-slice;if(rows>maxRows){maxRows=rows;}if(took>maxSlice){maxSlice=took;}if(rows>3){throw new Lang.Exception("row cap exceeded");}if(done){timer.stop();System.println("TIMED_MAP_DONE steps="+steps+" elapsedMs="+(System.getTimer()-started)+" maxRows="+maxRows+" maxSliceMs="+maxSlice+" bitmap="+(decoder.bitmap!=null)+" outline="+(decoder.outlineBitmap!=null));}} function onUpdate(dc){dc.clear();}}
(:background,:typecheck(false)) class TimerApp extends Application.AppBase {function initialize(){AppBase.initialize();}function getInitialView(){return [new TimerView()];}}
