import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.WatchUi;
(:typecheck(false)) class RasterFaultStore extends NativeStore {var failKey=null;var fired=false;function initialize(){NativeStore.initialize();}function write(key,value){if(failKey!=null&&key.equals(failKey)){fired=true;throw new Lang.InvalidValueException("controlled raster write failure");}NativeStore.write(key,value);}}
(:typecheck(false)) class NegativeView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {
 var store;var cache;var immutable;var stage=0;var pos=0;var objects=[Rez.JsonData.ObjA0,Rez.JsonData.ObjA1,Rez.JsonData.ObjA2,Rez.JsonData.ObjA3,Rez.JsonData.ObjA4,Rez.JsonData.ObjA5,Rez.JsonData.ObjA6,Rez.JsonData.ObjA7,Rez.JsonData.ObjA8,Rez.JsonData.ObjA9,Rez.JsonData.ObjA10,Rez.JsonData.ObjA11,Rez.JsonData.ObjA12,Rez.JsonData.ObjA13,Rez.JsonData.ObjA14,Rez.JsonData.ObjA15,Rez.JsonData.ObjA16,Rez.JsonData.ObjA17];var build;var prior;var missing;
 function initialize(){AppBase.initialize();NativeMetrics.ownerTag="885f41164651468b8e86d3ad3e99e8e2|raster-fault|97617aca74ef";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);}
 function ensure(ok,msg){if(!ok){System.println("NEG_FAIL "+msg);throw new Lang.InvalidValueException(msg);}}
 function getInitialView(){store=new RasterFaultStore();cache=new NativeCache("https://negative.invalid",store);immutable=new NativeImmutable(store);ensure(store.read("sf.commit")==null,"fresh");return [new NegativeView(self)];}
 function again(){WatchUi.requestUpdate();}
 function step(){
 if(stage==0||stage==2){if(pos<objects.size()){var item=WatchUi.loadResource(objects[pos]);ensure(immutable.put(item["ref"],item["raw"]),"seed "+pos);pos+=1;again();return;}if(stage==0){ensure(cache.accept(WatchUi.loadResource(Rez.JsonData.FeedA)["raw"],1794551192l),"accept A");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage=1;}else{missing=WatchUi.loadResource(Rez.JsonData.ObjB5);ensure(!immutable.put(missing["ref"],missing["raw"]+"x"),"reject corrupted bytes");ensure(immutable.raw(missing["ref"])==null,"missing remains absent");ensure(cache.accept(WatchUi.loadResource(Rez.JsonData.FeedB)["raw"],1794551192l),"accept fresh B schedule");var view=new SpaceFoxView(new WatchClock(),new ScheduleState(null,"empty"));var old=new NativeSfrRenderer();old.selectionHash="426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70";view.downloaded=old;view.setPacket(cache.packet);ensure(view.downloaded==null&&view.context.launchId.equals("ll2:launch:0f867f0c-5422-4d44-93b8-d7faaae7019b"),"no old bitmap under B");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage=3;}again();return;}
 if(stage==1){if(!build.step()){again();return;}prior=store.read("sf.raster.active")["selectionHash"];ensure(prior.equals("426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70"),"A active");build=null;objects=[Rez.JsonData.ObjB0,Rez.JsonData.ObjB1,Rez.JsonData.ObjB2,Rez.JsonData.ObjB3,Rez.JsonData.ObjB4,Rez.JsonData.ObjB6,Rez.JsonData.ObjB7,Rez.JsonData.ObjB8,Rez.JsonData.ObjB9,Rez.JsonData.ObjB10,Rez.JsonData.ObjB11,Rez.JsonData.ObjB12,Rez.JsonData.ObjB13,Rez.JsonData.ObjB14,Rez.JsonData.ObjB15,Rez.JsonData.ObjB16,Rez.JsonData.ObjB17];pos=0;stage=2;again();return;}
 if(stage==3){var refused=false;try{build.step();}catch(ex){refused=true;System.println("NEG_EXPECTED missingObject="+ex.getErrorMessage());}if(!refused){again();return;}ensure(store.read("sf.raster.active")["selectionHash"].equals(prior),"partial activated");ensure(cache.packet.document["publisher"]["generation"]==2&&cache.packet.validation==1794551192l,"B source facts");ensure(immutable.put(missing["ref"],missing["raw"]),"retry missing object");build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);store.failKey="sf.raster.recovery";stage=4;again();return;}
 if(stage==4||stage==5){var failed=false;try{if(build.step()){ensure(false,"fault not reached");}}catch(ex){failed=true;}if(!failed){again();return;}ensure(store.fired,"fault reached");ensure(store.read("sf.raster.active")["selectionHash"].equals(prior),"old pointer changed");store.fired=false;store.failKey=stage==4?"sf.raster.active":null;build=new NativeSfrBuild(store,"https://negative.invalid",cache.packet);stage+=1;again();return;}
 if(stage==6){if(!build.step()){again();return;}ensure(build.result.selectionHash.equals("7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de")&&store.read("sf.raster.active")["selectionHash"].equals("7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de"),"B active");ensure(store.read("sf.raster.recovery")["selectionHash"].equals(prior),"A recovery");System.println("RASTER_FAULT_COMPLETE recoveryWriteAndActiveWriteInjected=true oldPointerPreserved=true retryB=true recoveryA=true");stage=99;System.exit();}
 }
}