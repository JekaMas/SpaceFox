import Toybox.Graphics;import Toybox.Test;import Toybox.System;
(:typecheck(false)) class GuardClock extends WatchClock {var now=1794540000l; function utcSeconds(){return now;}}
(:typecheck(false)) class GuardView extends SpaceFoxView {var paints=0;var masks=0;var testClock; function initialize(c){SpaceFoxView.initialize(c,new ScheduleState(null,"empty"));testClock=c;} function drawScene(dc){paints+=1;aodMinute=utcMinute(testClock.utcSeconds());} function applyPixelRest(dc){masks+=1;}}
(:test,:typecheck(false)) function independentLowGuard(logger){var clock=new GuardClock();var v=new GuardView(clock);var bmp=Graphics.createBufferedBitmap({:width=>390,:height=>390,:colorDepth=>16}).get();var dc=bmp.getDc();v.updateForDisplayMode(dc,System.DISPLAY_MODE_LOW_POWER);Test.assert(v.paints==1&&v.masks==1);v.updateForDisplayMode(null,System.DISPLAY_MODE_LOW_POWER);Test.assert(v.paints==1&&v.masks==1);clock.now+=60;v.updateForDisplayMode(dc,System.DISPLAY_MODE_LOW_POWER);Test.assert(v.paints==2&&v.masks==2);v.sceneBuffer=bmp;v.sceneScaleOptions={};clock.now+=60;v.updateForDisplayMode(dc,System.DISPLAY_MODE_LOW_POWER);Test.assert(v.paints==3&&v.masks==3);v.updateForDisplayMode(null,System.DISPLAY_MODE_LOW_POWER);Test.assert(v.paints==3&&v.masks==3);logger.debug("GUARD PASS direct and buffered duplicate updates bypass paint mask blit; next minute draws");return true;}
