 var incoming=new NativeIncoming(store,base);incoming.processed("feed",old);var newerRaw=WatchUi.loadResource(Rez.JsonData.B1LiveFeed)["raw"];if(!transfer.stage("feed",newerRaw,null)){throw new Lang.InvalidValueException("stage new");}var newer=store.read("sf.incoming.feed");newerRaw=null;if(newer["sha256"].equals(old["sha256"])){throw new Lang.InvalidValueException("same source");}store.write("sf.wd.warm",newer);store.write("sf.incoming.feed",old);store.write("sf.attempt",{"base"=>base,"utc"=>Time.now().value().toLong(),"build"=>NativeVersion.BUILD});logger.debug("PAIR_SINGLE_SEED generations=56,57 completed=true");return true;
