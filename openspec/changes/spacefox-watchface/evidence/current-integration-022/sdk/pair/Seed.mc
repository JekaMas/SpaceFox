(:test,:typecheck(false)) function seedCapturedPair(logger){
 Application.Storage.clearValues();var store=new NativeStore();var base="https://jekamas.github.io/SpaceFox";var transfer=new NativeTransfer(base,store);var raw=WatchUi.loadResource(Rez.JsonData.B1Feed)["raw"];if(!transfer.stage("feed",raw,null)){throw new Lang.InvalidValueException("stage old");}var old=store.read("sf.incoming.feed");var batch=new NativeBatch(store,base);if(!batch.begin(raw)){throw new Lang.InvalidValueException("batch begin");}var n=0;while(true){var ref=batch.next();if(ref==null){break;}var response=b1Response(ref["path"]);if(response==null||!batch.immutable.put(ref,response)){throw new Lang.InvalidValueException("object failed");}n+=1;if(n>40){throw new Lang.InvalidValueException("object bound");}}batch=null;
