import Toybox.Lang;import Toybox.System;import Toybox.WatchUi;import Toybox.Application;
(:typecheck(false)) class ActualReplacementView extends WatchUi.WatchFace {
 var app;var sent=false;var had=false;var reported=false;var completed=false;var acceptedLogged=false;var firstFrame=false;function generation(){if(app.feed==null||app.feed.packet==null){return -1;}var packet=app.feed.packet;var pub=packet instanceof NativePrior?packet.publisher:packet.document["publisher"];return pub==null?-1:pub["generation"]; }function initialize(a){WatchFace.initialize();app=a;}function onLayout(dc){System.println("PAIR_PROXY onLayout");app.view.onLayout(dc);}function onShow(){System.println("PAIR_PROXY onShow");app.view.onShow();}function onHide(){System.println("PAIR_PROXY onHide");app.view.onHide();}function onEnterSleep(){app.view.onEnterSleep();}function onExitSleep(){app.view.onExitSleep();}
 function onUpdate(dc){if(acceptedLogged){System.println("PAIR_FRAME enter free="+app.view.optionalHeapFree());}if(!firstFrame){firstFrame=true;System.println("PAIR_PROXY onUpdate canWork="+app.view.canForegroundWork()+" bootstrap="+app.view.bootstrapPending+" loader="+(app.view.pendingLoader!=null));}app.view.onUpdate(dc);if(acceptedLogged){System.println("PAIR_FRAME done free="+app.view.optionalHeapFree());}if(!sent&&app.view.sfrBuild!=null){var currentGen=generation();if(currentGen!=56){System.println("PAIR_PRECONDITION_FAILED gen="+currentGen);sent=true;return;}System.println("PAIR_PRECONDITION gen=56 sfr=true");had=true;var store=new NativeStore();var marker=store.read("sf.wd.warm");store.write("sf.incoming.feed",marker);sent=true;System.println("REAL_REPLACEMENT marker_flip_during_sfr=true");app.onBackgroundData(null);WatchUi.requestUpdate();}if(sent&&!reported&&app.view.sfrBuild==null&&app.admissionJob!=null){reported=true;System.println("REAL_REPLACEMENT admission_after_cancel=true");}if(reported&&!acceptedLogged&&generation()==57){acceptedLogged=true;System.println("PAIR_ACCEPTED gen=57");}if(reported&&!completed&&app.view.downloaded!=null&&generation()==57){completed=true;System.println("REAL_REPLACEMENT visual_complete=true used="+System.getSystemStats().usedMemory);}}
}
(:background,:typecheck(false)) class ColdEventApp extends SpaceFoxApp {function initialize(){SpaceFoxApp.initialize();}(:typecheck(disableBackgroundCheck)) function getInitialView(){SpaceFoxApp.getInitialView();return [new ActualReplacementView(self)];}}
