import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.WatchUi;
(:typecheck(false)) class AbcView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {
 var store;var cache;var immutable;var stage;var pos=0;var objects;var build;var packet;var pending;
 function initialize(){AppBase.initialize();NativeMetrics.ownerTag="805ca51acffe4b949f9e1f1209c750ae|abc|f7d9973f9a1f";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);}
 function ensure(v,s){if(!v){System.println("ABC_FAIL "+s);throw new Lang.InvalidValueException(s);}}
 function getInitialView(){store=new NativeStore();cache=new NativeCache("https://catalog-local.invalid",store);immutable=new NativeImmutable(store);var nonce=Application.Storage.getValue("sf.abc.nonce");
 if(nonce==null){stage=0;objects=[Rez.JsonData.ObjA0,Rez.JsonData.ObjA1,Rez.JsonData.ObjA2,Rez.JsonData.ObjA3,Rez.JsonData.ObjA4,Rez.JsonData.ObjA5,Rez.JsonData.ObjA6,Rez.JsonData.ObjA7,Rez.JsonData.ObjA8,Rez.JsonData.ObjA9,Rez.JsonData.ObjA10,Rez.JsonData.ObjA11,Rez.JsonData.ObjA12,Rez.JsonData.ObjA13,Rez.JsonData.ObjA14,Rez.JsonData.ObjA15,Rez.JsonData.ObjA16,Rez.JsonData.ObjA17];}else{ensure(nonce.equals("28921aaedba148dbb2e2f78f06e274f4"),"nonce");ensure(cache.load(1794551192l)!=null,"load prior");var g=cache.packet.document["publisher"]["generation"];if(g==1){stage=20;objects=[Rez.JsonData.ObjB0,Rez.JsonData.ObjB1,Rez.JsonData.ObjB2,Rez.JsonData.ObjB3,Rez.JsonData.ObjB4,Rez.JsonData.ObjB5,Rez.JsonData.ObjB6,Rez.JsonData.ObjB7,Rez.JsonData.ObjB8,Rez.JsonData.ObjB9,Rez.JsonData.ObjB10,Rez.JsonData.ObjB11,Rez.JsonData.ObjB12,Rez.JsonData.ObjB13,Rez.JsonData.ObjB14,Rez.JsonData.ObjB15,Rez.JsonData.ObjB16,Rez.JsonData.ObjB17];pending=WatchUi.loadResource(Rez.JsonData.RefsB)["refs"];}else{ensure(g==2,"generation B");stage=40;objects=[Rez.JsonData.ObjC0,Rez.JsonData.ObjC1,Rez.JsonData.ObjC2,Rez.JsonData.ObjC3,Rez.JsonData.ObjC4,Rez.JsonData.ObjC5,Rez.JsonData.ObjC6,Rez.JsonData.ObjC7,Rez.JsonData.ObjC8,Rez.JsonData.ObjC9,Rez.JsonData.ObjC10,Rez.JsonData.ObjC11,Rez.JsonData.ObjC12,Rez.JsonData.ObjC13,Rez.JsonData.ObjC14,Rez.JsonData.ObjC15,Rez.JsonData.ObjC16,Rez.JsonData.ObjC17];pending=WatchUi.loadResource(Rez.JsonData.RefsC)["refs"];var a=store.read("sf.raster.active");var r=store.read("sf.raster.recovery");ensure(a["selectionHash"].equals("7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de")&&r["selectionHash"].equals("426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70"),"B active A recovery");}store.write("sf.batch.refs",{"base"=>"https://catalog-local.invalid","refs"=>pending});}System.println("ABC_OPEN stage="+stage);return [new AbcView(self)];}
 function step(){if(stage==50){var f=WatchUi.loadResource(Rez.JsonData.FeedC)["raw"];ensure(cache.accept(f,1794551192l),"accept C feed");packet=cache.packet;build=new NativeSfrBuild(store,"https://catalog-local.invalid",packet);stage=41;WatchUi.requestUpdate();return;}if(stage==0||stage==20||stage==40){if(pos<objects.size()){var v=WatchUi.loadResource(objects[pos]);ensure(immutable.put(v["ref"],v["raw"]),"put stage="+stage+" pos="+pos);pos+=1;WatchUi.requestUpdate();return;}
 if(stage==40){var markers=[store.read("sf.raster.active"),store.read("sf.raster.recovery")];for(var z=0;z<markers.size();z+=1){var refs=markers[z]["refs"];for(var x=0;x<refs.size();x+=1){var r=refs[x];ensure(immutable.raw({"sha256"=>r[1],"decodedBytes"=>r[2]})!=null,"protected object lost");}}System.println("ABC_PRECOMMIT C objects="+store.read("sf.objects").size()+" B-active A-recovery C-pending intact=true");stage=50;WatchUi.requestUpdate();return;}
 var f=WatchUi.loadResource(stage==0?Rez.JsonData.FeedA:stage==20?Rez.JsonData.FeedB:Rez.JsonData.FeedC)["raw"];ensure(cache.accept(f,1794551192l),"accept feed");packet=cache.packet;build=new NativeSfrBuild(store,"https://catalog-local.invalid",packet);stage+=1;WatchUi.requestUpdate();return;}
 if(stage==1||stage==21||stage==41){if(!build.step()){WatchUi.requestUpdate();return;}var result=build.result;var expected=stage==1?"426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70":stage==21?"7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de":"e4586771e6f15aba964a1c1f1c65ad05cbd9ac79991a7ce7cd8204382d605425";ensure(result.selectionHash.equals(expected)&&result.mapBitmap!=null&&result.bitmap!=null&&result.siteCountryBitmap!=null,"scene");var active=store.read("sf.raster.active");ensure(active["selectionHash"].equals(expected),"active");if(stage==21||stage==41){var recovery=store.read("sf.raster.recovery");ensure(recovery["selectionHash"].equals(stage==21?"426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70":"7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de"),"recovery");}if(stage==1){Application.Storage.setValue("sf.abc.nonce","28921aaedba148dbb2e2f78f06e274f4");}System.println("ABC_COMPLETE stage="+stage+" objects="+store.read("sf.objects").size()+" scene=true recovery=true");stage=99;System.exit();return;}}
}