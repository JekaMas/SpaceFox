import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.WatchUi;
(:typecheck(false)) class BudgetRealStore extends NativeStore {function initialize(){NativeStore.initialize();} function write(k,v){System.println("WRITE_START "+k+" used="+System.getSystemStats().usedMemory);NativeStore.write(k,v);}}
(:typecheck(false)) class BudgetView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {
 var store;var cache;var base;var n=0;var done=false;
 function initialize(){AppBase.initialize();NativeMetrics.ownerTag="9df891ed84d6494fa22eefd193b96bd9|storage|f7d9973f9a1f";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);}
 function ensure(v,s){if(!v){System.println("STORAGE_FAIL "+s);throw new Lang.InvalidValueException(s);}}
 function getInitialView(){store=new BudgetRealStore();cache=new NativeImmutable(store);base=WatchUi.loadResource(Rez.JsonData.Object)["raw"];ensure(store.read("sf.objects")==null,"fresh");return [new BudgetView(self)];}
 function step(){if(done){return;}if(n<56){var suffix="00"+n; suffix=suffix.substring(suffix.length()-3,suffix.length());var raw=base.substring(0,base.length()-3)+suffix;var h=new NativeWireHash();h.put(raw);var ref={"sha256"=>h.digest(),"decodedBytes"=>4096};ensure(cache.put(ref,raw),"put "+n);n+=1;if(n%16==0){System.println("STORAGE_PROGRESS entries="+n);}WatchUi.requestUpdate();return;}
 var rows=store.read("sf.objects");ensure(rows.size()==56,"index size");var refs=[];for(var i=0;i<56;i+=1){refs.add([0,rows[i][0],4096]);}store.write("sf.raster.active",{"refs"=>refs.slice(0,18)});store.write("sf.raster.recovery",{"refs"=>refs.slice(18,37)});store.write("sf.batch.refs",{"refs"=>refs.slice(37,56)});var raw=base.substring(0,base.length()-3)+"056";var h=new NativeWireHash();h.put(raw);var ref={"sha256"=>h.digest(),"decodedBytes"=>4096};var before=store.writes;ensure(!cache.put(ref,raw),"full protected accepted");ensure(store.writes==before,"full protected changed");store.write("sf.batch.refs",{"refs"=>refs.slice(37,55)});ensure(cache.put(ref,raw),"safe eviction refused");ensure(store.read("sf.obj."+rows[55][0])==null,"unreferenced retained");ensure(store.read("sf.obj."+rows[0][0])!=null,"active lost");before=store.writes;ensure(cache.put(ref,raw)&&store.writes==before,"reuse wrote");var chunk=base.substring(1500,2012);for(var slot=0;slot<3;slot+=1){for(var part=0;part<16;part+=1){store.write("sf.feed."+slot+"."+part,chunk);}store.write("sf.feed."+slot,{"v"=>2,"base"=>"https://selected.invalid","chunks"=>16,"rawHash"=>ref["sha256"],"mutableSpans"=>[]});}System.println("STORAGE_COMPLETE entries=56 objectBytes=229376 feedSlots=3 feedChunkBytes=24576 protectedRefused=true evictedOne=true reused=true used="+System.getSystemStats().usedMemory);done=true;System.exit();}
}
