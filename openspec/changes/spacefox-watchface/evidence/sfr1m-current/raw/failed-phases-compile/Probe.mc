import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.Time;import Toybox.WatchUi;
(:typecheck(false)) class PhasesView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {
 var store;var cache;var immutable;var stage;var pos=0;var objects;var build;var packet;var before;
 function initialize(){AppBase.initialize();NativeMetrics.ownerTag="c151b9b7313c48f4b8de08bab6f73a6b|phases-r2|a17f5b201376";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);}
 function ensure(ok,msg){if(!ok){System.println("CAT_FAIL "+msg);throw new Lang.InvalidValueException(msg);}}
 function getInitialView(){store=new NativeStore();cache=new NativeCache("https://catalog-local.invalid",store);immutable=new NativeImmutable(store);var nonce=Application.Storage.getValue("sf.ca.nonce");var now=Time.now().value().toLong();stage=nonce==null?0:Application.Storage.getValue("sf.ca.stage");System.println("CAT_OPEN stage="+stage+" nonce="+nonce+" epoch="+now);
 if(stage==0){ensure(nonce==null&&store.read("sf.commit")==null,"fresh namespace");objects=[Rez.JsonData.ObjA0,Rez.JsonData.ObjA1,Rez.JsonData.ObjA2,Rez.JsonData.ObjA3,Rez.JsonData.ObjA4,Rez.JsonData.ObjA5,Rez.JsonData.ObjA6,Rez.JsonData.ObjA7,Rez.JsonData.ObjA8,Rez.JsonData.ObjA9,Rez.JsonData.ObjA10,Rez.JsonData.ObjA11,Rez.JsonData.ObjA12,Rez.JsonData.ObjA13,Rez.JsonData.ObjA14,Rez.JsonData.ObjA15,Rez.JsonData.ObjA16,Rez.JsonData.ObjA17];}
 else {ensure(nonce instanceof String&&nonce.equals("c435d2be76394a95b333c9d1f4deee50"),"nonce missing");if(stage==20){ensure(cache.load(1794551192l)!=null&&cache.packet.document["publisher"]["generation"]==1,"load prior A before B");objects=[Rez.JsonData.ObjB0,Rez.JsonData.ObjB1,Rez.JsonData.ObjB2,Rez.JsonData.ObjB3,Rez.JsonData.ObjB4,Rez.JsonData.ObjB5,Rez.JsonData.ObjB6,Rez.JsonData.ObjB7,Rez.JsonData.ObjB8,Rez.JsonData.ObjB9,Rez.JsonData.ObjB10,Rez.JsonData.ObjB11,Rez.JsonData.ObjB12,Rez.JsonData.ObjB13,Rez.JsonData.ObjB14,Rez.JsonData.ObjB15,Rez.JsonData.ObjB16,Rez.JsonData.ObjB17];}}
 return [new PhasesView(self)];}
 function again(){WatchUi.requestUpdate();}
 function step(){
 if(stage==0||stage==20){if(pos<objects.size()){var value=WatchUi.loadResource(objects[pos]);ensure(immutable.put(value["ref"],value["raw"]),"object put "+pos);pos+=1;again();return;}var feed=WatchUi.loadResource(stage==0?Rez.JsonData.FeedA:Rez.JsonData.FeedB)["raw"];ensure(cache.accept(feed,1794551192l),"feed accept");packet=cache.packet;build=new NativeSfrBuild(store,"https://catalog-local.invalid",packet);stage=stage==0?1:21;again();return;}
 if(stage==10||stage==30){before=store.writes;ensure(cache.load(1794551192l)!=null,"reopen feed");packet=cache.packet;build=new NativeSfrBuild(store,"https://catalog-local.invalid",packet);stage=stage==10?11:31;again();return;}
 if(stage==1||stage==11||stage==21||stage==31){if(!build.step()){again();return;}var result=build.result;var isB=stage==21||stage==31;var expected=isB?"7057edc141cbe62f1e71bd32ff2bfbe1ec9de2bac8bfd7509ec0866026e648de":"426804295ad5943e1d73e755ba0b38e105f4fec8de8479bf470671e7f62dba70";var active=store.read("sf.raster.active");ensure(result.selectionHash.equals(expected)&&result.mapBitmap!=null&&result.bitmap!=null&&result.siteCountryBitmap!=null,"complete decoded selected scene");ensure(active["selectionHash"].equals(expected),"active pointer");ensure(packet.launchId().equals("ll2:launch:0f867f0c-5422-4d44-93b8-d7faaae7019b"),"identity");ensure(packet.document["publisher"]["generation"]==(isB?2:1),"generation");ensure(packet.bridge["site"]["position"]["latitude"].equals(isB?"26.99677":"25.99677"),"position");if(stage==11||stage==31){ensure(store.writes==before,"reopen writes");}if(stage==1){Application.Storage.setValue("sf.ca.nonce","c435d2be76394a95b333c9d1f4deee50");} Application.Storage.setValue("sf.ca.stage",stage==1?10:stage==11?20:stage==21?30:99);System.println("CAT_PHASE stage="+stage+" generation="+(isB?2:1)+" selected="+expected+" position="+packet.bridge["site"]["position"]["latitude"]+" fullScene=true reopenNoWrites="+(stage==11||stage==31));stage=99;System.exit();return;}
 }
}