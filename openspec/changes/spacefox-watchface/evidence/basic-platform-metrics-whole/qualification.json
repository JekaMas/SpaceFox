  "languageAndConstantReview": "All actual30 source files including generated mappings reviewed. Stable basic Lang collection/numeric/string operations and inherited AppBase/WatchFace/ServiceDelegate lifecycle APIs are available before5.1. System language constants retain36resource mappings. NativeResources reference aliases are source-owned classes, not new device APIs. Explicit references and indirect Dc/Bitmap/Hash/Timer/AffineTransform operations are checked against pinned local official docs. This is a reviewed finite current source inventory, not general or alias-aware API analysis.",
  "extendedCode": {
    "minimumApi": "5.1.0",
    "sourceFiles": [
      "watchface/source/LocalePresentation.mc",
      "watchface/source/NativeAnimation.mc",
      "watchface/source/NativeBridgeFeed.mc",
      "watchface/source/NativeCache.mc",
      "watchface/source/NativeFeed.mc",
      "watchface/source/NativeForegroundApp.mc",
      "watchface/source/NativeForegroundCache.mc",
      "watchface/source/NativeIncoming.mc",
      "watchface/source/NativeJson.mc",
      "watchface/source/NativeRenderSource.mc",
      "watchface/source/NativeSfr.mc",
      "watchface/source/SceneContext.mc",
      "watchface/source/SceneRenderer.mc",
      "watchface/source/SceneSettings.mc",
      "watchface/source/SpaceFoxView.mc",
      "watchface/source/generated/LocaleGraphemes.mc",
      "watchface/source/generated/SceneStrings.mc"
    ],
    "reason": "Current source uses :extendedCode; actual manifest min5.1 retained. SDK9.3 is compiler version, not runtime support.",
    "documentation": {
      "path": "doc/docs/Monkey_C/Annotations.html",
      "sha256": "3753e744b1c4c4e3a1e393791f2f6e1ab5831a24afc0d4420bac31ad92c0e48c"
    }
  },
  "permissions": {
    "SensorHistory": "Only recent heart/bodybattery/stress source reads in guarded Fitness adapter; one newest sample, no raw sensor streaming.",
    "Communications": "FeedService public static JSON GET requests with empty request parameters; no health field upload.",
    "Background": "FeedService temporal event delegate for launch/feed updates, independent of health sampling."
  },
  "notDeclared": [
    "Sensor",
    "Positioning",
    "FitContributor",
    "UserProfile"
  ],
  "healthSourceReview": "Fitness has only ActivityMonitor info steps/calories, System stats charge, guarded SensorHistory per-source calls. Each next called once, explicit period1/newest. Only values/null returned to face. No raw sensor/register listener, upload, storage or entire history traversal in field path. FeedService network path sends static GETs with empty request payload, never Fitness values. Source review plus actual bounded trace doubles; not a physical telemetry audit.",
