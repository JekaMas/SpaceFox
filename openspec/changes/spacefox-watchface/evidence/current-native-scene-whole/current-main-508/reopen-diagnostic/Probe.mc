import Toybox.Application;import Toybox.Lang;import Toybox.System;import Toybox.Time;import Toybox.WatchUi;
(:typecheck(false)) class ProbeView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {var stepNum=0;var store;var cache;var marker;function initialize(){AppBase.initialize();System.println("SFR_PROBE owner=b1a6edd46c264da991b8520129eb6731|reopen-diagnostic|f46511d66294");}function getInitialView(){store=new NativeStore();cache=new NativeCache("https://lifecycle.invalid",store);return [new ProbeView(self)];}function step(){if(stepNum==0){marker=store.read("sf.commit");System.println("DIAG commit="+(marker!=null)+" base="+cache.base+" used="+System.getSystemStats().usedMemory);stepNum++;WatchUi.requestUpdate();return;}if(stepNum==1){try{var p=cache.checkedProjection(marker,Time.now().value().toLong());System.println("DIAG projection="+(p!=null)+" raw="+cache.verifyRaw(marker)+" used="+System.getSystemStats().usedMemory);}catch(e){System.println("DIAG projection exception="+e.getErrorMessage());}stepNum++;WatchUi.requestUpdate();return;}if(stepNum==2){try{var p=cache.readCommit(marker,Time.now().value().toLong());System.println("DIAG readCommit="+(p!=null)+" used="+System.getSystemStats().usedMemory);}catch(e){System.println("DIAG readCommit exception="+e.getErrorMessage());}stepNum++;System.exit();}}}
