(:typecheck(false)) class IntegrationBatchCounter {var actual;var refs;var checks=0;var bytes=0;function initialize(s,r){actual=new NativeImmutable(s);refs=r;}function raw(ref){var value=actual.raw(ref);if(value!=null&&refs.hasKey(ref["sha256"])){checks+=1;bytes+=ref["decodedBytes"];}return value;}function put(ref,value){return actual.put(ref,value);}}
