(:typecheck(false)) function integrationClean(store){var resources=integrationResources();var paths=resources.keys();for(var i=0;i<paths.size();i+=1){var item=WatchUi.loadResource(resources[paths[i]]);store.remove("sf.obj."+item["sha256"]);}store.remove("sf.batch.head");store.remove("sf.batch.refs");store.remove("sf.batch.pending");store.remove("sf.commit");store.remove("sf.recovery");}

(:typecheck(false)) function integrationPut(batch,ref){var id=integrationResources()[ref["path"]];Test.assert(id!=null);var item=WatchUi.loadResource(id);Test.assert(item["sha256"].equals(ref["sha256"])&&batch.immutable.put(ref,item["raw"]));}
(:test,:typecheck(false)) function integrationBatchLinearAndTerminal(logger){
 var store=new NativeStore();integrationClean(store);var base="https://rollover017.fixture.invalid";var batch=new NativeBatch(store,base);var raw=WatchUi.loadResource(Rez.JsonData.BatchFeed)["raw"];Test.assert(batch.begin(raw));var counted=new IntegrationBatchCounter(store,integrationRefs());batch.immutable=counted;var got=0;
 while(true){var ref=batch.next();if(ref==null){break;}integrationPut(batch,ref);got+=1;Test.assert(got<=19);}
 Test.assert(got==19&&counted.checks==34&&counted.bytes==100010);var first="77d4b3173b019ee84b7eb751e81ccb7a47edfba560a54166bfb47f441e8b7b37";store.write("sf.obj."+first,"bad");var reopened=new NativeBatch(store,base);var missing=reopened.next();Test.assert(missing!=null&&missing["sha256"].equals(first));logger.debug("INTEGRATION_BATCH refs=17 uniqueBytes=50005 prefix=17 terminal=17 checks="+counted.checks+" hashedBytes="+counted.bytes+" restartCorruptionRefused=true");return true;
}
(:test,:typecheck(false)) function integrationBatchCorruptPrefixBeforeCompletion(logger){
 var store=new NativeStore();integrationClean(store);var base="https://rollover017.fixture.invalid";var batch=new NativeBatch(store,base);var raw=WatchUi.loadResource(Rez.JsonData.BatchFeed)["raw"];Test.assert(batch.begin(raw));var got=0;var corrupted=false;var refused=false;var seal=null;var damaged="77d4b3173b019ee84b7eb751e81ccb7a47edfba560a54166bfb47f441e8b7b37";
 while(true){var ref=batch.next();if(got==3&&!corrupted){Test.assert(batch.verifiedPrefix>=1);var prepared=new NativePreparedBridgeFeed(raw,1794826622l,store);var n=0;while(!prepared.prepareStep()){n+=1;Test.assert(n<2000);}var cache=new NativeCache(base,store);var promotion=new NativeFeedPromotion(cache,raw,prepared,1794826622l,null);n=0;while(!promotion.step()){n+=1;Test.assert(n<50);}Test.assert(promotion.accepted);seal=store.read("sf.commit")["seal"];store.write("sf.raster.active",{"base"=>base,"selectionHash"=>"prior"});store.write("sf.obj."+damaged,"bad");corrupted=true;}
  if(ref==null){break;}if(corrupted&&got>=19){Test.assert(ref["sha256"].equals(damaged)&&store.read("sf.commit")["seal"].equals(seal)&&store.read("sf.raster.active")["selectionHash"].equals("prior"));refused=true;}integrationPut(batch,ref);got+=1;Test.assert(got<=20);}
 Test.assert(refused&&got==20&&store.read("sf.commit")["seal"].equals(seal)&&store.read("sf.raster.active")["selectionHash"].equals("prior"));logger.debug("INTEGRATION_PREFIX_CORRUPTION terminalScanRefused=true repaired=true acceptedAndRasterUnchanged=true");return true;
}
