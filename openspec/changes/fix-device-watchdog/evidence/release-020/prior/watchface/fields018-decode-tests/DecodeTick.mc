import Toybox.Application;import Toybox.Graphics;import Toybox.Lang;import Toybox.System;import Toybox.Test;import Toybox.Time;import Toybox.WatchUi;
(:background) class SfrRuntimeApp extends SpaceFoxApp {function initialize(){SpaceFoxApp.initialize();}}
(:test,:typecheck(false)) class TickClock extends WatchClock {var now;function initialize(n){WatchClock.initialize();now=n;}function utcSeconds(){return now;}function localTimeText(){return "08:08";}}
(:test,:typecheck(false)) class TickRenderer extends SceneRenderer {var calls=0;var textValue=null;function initialize(){SceneRenderer.initialize(null);}function active(dc,s,settings,values,fitness,progress){calls+=1;textValue=s.countdown;}}
(:test,:typecheck(false)) function fields018DecodeTick(logger){
 var store=new NativeStore();var base="https://rollover017.fixture.invalid";var row=new NativeIncoming(store,base).read("feed",true);Test.assert(row!=null);var now=Time.now().value().toLong();var feed=new NativeBridgeFeed(row[1],now,store);var source=new NativeRenderSource(store,base,feed.bridge);Test.assert(source.ready&&source.selectionHash.equals("77d4b3173b019ee84b7eb751e81ccb7a47edfba560a54166bfb47f441e8b7b37"));Test.assert(feed.document["upcoming"].size()==2);
 var clock=new TickClock(now);var view=new SpaceFoxView(clock,new ScheduleState(null,"empty"));view.setPacket(feed);var renderer=new TickRenderer();renderer.prepare(view.context,view.settings);view.renderer=renderer;view.onShow();var dc=Graphics.createBufferedBitmap({:width=>390,:height=>390}).get().getDc();view.updateForDisplayMode(dc,System.DISPLAY_MODE_HIGH_POWER);var before=renderer.textValue;Test.assert(renderer.calls==1);view.setAssetCache(source);view.prepareVisual();view.sfrStep();Test.assert(view.sfrBuild!=null);
 var start=System.getTimer();var steps=0;while(steps<20&&view.sfrBuild!=null){view.sfrStep();steps+=1;}logger.debug("REAL_A2_PENDING slices="+steps+" cadenceMs=50 minimumWallMs="+(steps*50)+" cpuMs="+(System.getTimer()-start)+" rendererRetained="+(view.renderer!=null));Test.assert(view.sfrBuild!=null);
 clock.now+=1;view.updateForDisplayMode(dc,System.DISPLAY_MODE_HIGH_POWER);logger.debug("ACTIVE_TICK calls="+renderer.calls+" countdown="+renderer.textValue);Test.assertMessage(renderer.calls==2 && !renderer.textValue.equals(before),"active countdown must redraw while real scene decode is pending");view.syncDisplayMode(System.DISPLAY_MODE_LOW_POWER);Test.assert(view.sfrBuild==null && renderer.fonts.hasKey("aod"));view.onHide();return true;
}
