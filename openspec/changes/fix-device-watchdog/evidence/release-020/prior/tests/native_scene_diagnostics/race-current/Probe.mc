import Toybox.Application;import Toybox.Lang;import Toybox.WatchUi;import Toybox.System;
(:typecheck(false)) class RaceStore extends NativeStore {var enabled=false;var fired=false;function read(key){var v=NativeStore.read(key);if(enabled&&!fired&&key.find("sf.incoming.feed.")==0&&!key.equals("sf.incoming.feed.processed")){var m=NativeStore.read("sf.incoming.feed");m["sequence"]+=1;NativeStore.write("sf.incoming.feed",m);fired=true;}return v;}}
(:typecheck(false)) class RaceView extends WatchUi.WatchFace {var app;function initialize(a){WatchFace.initialize();app=a;}function onUpdate(dc){app.step();}}
(:typecheck(false)) class SfrRuntimeApp extends Application.AppBase {var s;var c;var seal;var floor;var stage=0;function initialize(){AppBase.initialize();NativeMetrics.ownerTag="91af2032aae54ba1934188fcdd55b018|race-current|7c6edd591566";System.println("SFR_PROBE owner="+NativeMetrics.ownerTag);}function ensure(ok,msg){if(!ok){System.println("RACE_FAIL "+msg);throw new Lang.InvalidValueException(msg);}}function getInitialView(){s=new RaceStore();c=new NativeCache("https://race.invalid",s);return [new RaceView(self)];}function step(){if(stage==0){var i=new NativeImmutable(s);var raw=WatchUi.loadResource(Rez.JsonData.CatalogA)["raw"];var h=new NativeWireHash();h.put(raw);var digest=h.digest();ensure(i.put({"path"=>"wire3/catalogs/"+digest+".json","sha256"=>digest,"decodedBytes"=>h.count},raw),"catalog");}else if(stage==1){ensure(c.accept(WatchUi.loadResource(Rez.JsonData.FeedA)["raw"],1794551192l),"accept A");seal=c.commit["seal"];floor=s.read(c.pinKey)["generation"];}else if(stage==2){var t=new NativeTransfer(c.base,s);ensure(t.stage("feed",WatchUi.loadResource(Rez.JsonData.FeedB)["raw"],null),"stage B");}else if(stage==3){s.enabled=true;var incoming=new NativeIncoming(s,c.base);ensure(!incoming.admitFeed(c,1794551192l)&&s.fired,"race not refused");ensure(c.packet!=null&&c.commit["seal"].equals(seal)&&s.read(c.pinKey)["generation"]==floor,"floor/restore lost");s.enabled=false;}else if(stage==4){c=null;c=new NativeCache("https://race.invalid",s);ensure(c.load(1794551192l)!=null&&c.commit["seal"].equals(seal),"reopen");System.println("ROOT_RACE_COMPLETE mutationReached=true incomingRefused=true oldSealAndFloor=true durableReopen=true");stage=99;System.exit();return;}stage+=1;WatchUi.requestUpdate();}}
