{"entries":[{"record":{"configuration_id":{"kind":"configuration","namespace":"ll2","value":"522"},"configuration_name":"Starship V3","country_code":"US","country_id":{"kind":"country","namespace":"ll2","value":"2"},"country_name":"United States of America","launch_id":{"kind":"launch","namespace":"ll2","value":"0f867f0c-5422-4d44-93b8-d7faaae7019b"},"mission_name":"Starlink Group 31-2 (Starship Flight 15)","mission_purpose":"15th test flight of the two-stage Starship launch vehicle and 4th flight of Starship V3. Second Starship flight to deploy satellites (a group of Starlink satellites known as Starlink Group 31-2) into stable Low Earth Orbit and first ever to attempt returning the Starship 2nd stage back to the launch site. The ship is expected to fly at an altitude approximately 275 km above Earth and complete approximately 14 orbits around the planet for more than 22 hours, with the ship expected to attempt returning back to Starbase, Texas on its launch pad by pad arms catching. The booster’s primary test objective on Flight 15 will be executing a successful launch, ascent, stage separation, boostback burn, and landing by pad arms catching. This will also be the 1st Starship V3 booster to attempt returning to its launch site. Starship will deliver 26 Starlink V3 satellites to orbit for the second time, which aim to greatly expand the network's capacity and user speeds. Each Starlink V3 satellite will add 1 Tbps of capacity to the constellation. 3 of the satellites have been modified with a suite of cameras to scan Starship’s heatshield and transmit imagery down to operators.","operator_id":{"kind":"organization","namespace":"ll2","value":"121"},"operator_name":"SpaceX","site_id":{"kind":"site","namespace":"ll2","value":"235"},"site_location_name":"SpaceX Starbase, TX, USA","site_name":"Orbital Launch Pad 2","source_status_id":8,"source_status_name":"To Be Confirmed","source_updated_iso":"2026-11-10T22:06:46Z","source_updated_utc":1794348406,"source_validated_u