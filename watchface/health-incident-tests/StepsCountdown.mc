import Toybox.Complications;import Toybox.Graphics;import Toybox.Test;import Toybox.Lang;import Toybox.Time;import Toybox.System;
(:test,:typecheck(false)) class StepsValue extends IncidentValue {function initialize(value){IncidentValue.initialize(value);}function getType(){return 2;}}
(:test,:typecheck(false)) class StepsApi extends IncidentApi {
 var stepReads=0;var currentStep=null;
 function get(id){if(id.getType()==2){stepReads+=1;return currentStep==null?null:new StepsValue(currentStep);}return IncidentApi.get(id);}
}
(:test,:typecheck(false)) class StepsFields extends IncidentFields {function savedField(slot){return new Complications.Id(2);}}
(:test,:typecheck(false)) class StepsDraw extends MenuDraw {var saw123=false;function drawText(x,y,f,t,flags){if(t.equals("123")){saw123=true;}MenuDraw.drawText(x,y,f,t,flags);}}
(:test,:typecheck(false)) class StepsInfo {var steps;var calories=90;function initialize(n){steps=n;}}
(:test,:typecheck(false)) class StepsFitness extends Fitness {
 var current=0;var calls=0;var failActivity=false;function activityAvailable(){return true;}function activityInfo(){calls+=1;if(failActivity){throw new Lang.InvalidValueException("activity failure");}return new StepsInfo(current);}
}
(:test,:typecheck(false)) function selectedStepsCallback(logger){
 var view=new MenuView();var fields=new IncidentFields();var api=new StepsApi();fields.api=api;view.selectedFields=fields;var fit=new StepsFitness();fit.selectedFields=fields;view.fitness=fit;view.values={"steps"=>0,"energy"=>70,"heart"=>80,"stress"=>20};view.onShow();fields.start(view.settings.slots,view.method(:fieldsChanged));
 Test.assertMessage(fields.includes(new Complications.Id(2)),"selected steps must subscribe to its Garmin complication");
 api.currentStep=123;var before=api.calls;view.fieldsChanged(new Complications.Id(2));Test.assertMessage(view.values["steps"]==123&&fit.calls==0,"changed Garmin steps must reach view even if ActivityMonitor is still zero");Test.assert(api.calls==before&&view.values["energy"]==70&&view.values["heart"]==80);var frame=new StepsDraw();view.onLayout(frame);view.onUpdate(frame);Test.assertMessage(frame.saw123,"changed value must reach actual frame");
 api.currentStep=0;view.fieldsChanged(new Complications.Id(2));Test.assert(view.values["steps"]==0);
 api.currentStep=null;fit.current=7;view.fieldsChanged(new Complications.Id(2));Test.assert(view.values["steps"]==7&&fit.calls==1);
 view.mode=System.DISPLAY_MODE_LOW_POWER;view.onEnterSleep();var lowReads=api.stepReads;api.currentStep=88;view.fieldsChanged(new Complications.Id(2));Test.assert(api.stepReads==lowReads);view.mode=System.DISPLAY_MODE_HIGH_POWER;view.onExitSleep();view.readFitnessSnapshot(1794818604l);Test.assert(view.values["steps"]==88);view.onHide();var prior=api.stepReads;var priorActivity=fit.calls;view.fieldsChanged(new Complications.Id(2));Test.assert(api.stepReads==prior&&fit.calls==priorActivity);for(var order=0;order<2;order+=1){var dup=new StepsFields();var dupApi=new StepsApi();dupApi.currentStep=42;dup.api=dupApi;var slots=order==0?["steps","custom2","heart","stress"]:["custom1","steps","heart","stress"];dup.start(slots,dup.method(:callback));dup.read("en");Test.assert(dupApi.stepReads==1&&dup.stepValue()==42&&dup.display(order==0?"custom2":"custom1").equals("42"));dup.stop();}logger.debug("STEPS_CALLBACK complication=123 zero=0 activity_fallback=7 hidden_no_read=true duplicate_orders=2 paint=true");return true;
}
(:test,:typecheck(false)) class CueTrace extends PhysicalFrameTrace {function getWidth(){return 390;}function getHeight(){return 390;}var lines=0;var firstX=null;var dots=0;function drawLine(x1,y1,x2,y2){if(firstX==null){firstX=x1;}lines+=1;}function fillCircle(x,y,r){if(r==1){dots+=1;}PhysicalFrameTrace.fillCircle(x,y,r);}}
(:test,:typecheck(false)) function countdownCues(logger){
 var settings=new SceneSettings(null);var c=new ClockSnapshot("08:25","T- 24:00:00");c.remainingUtc=86400;Test.assert(SceneAod.countdownColor(c,settings)==0xA3ADB8);c.remainingUtc=86399;Test.assert(SceneAod.countdownColor(c,settings)==settings.countdownColor);c.remainingUtc=0;Test.assert(SceneAod.countdownColor(c,settings)==settings.countdownColor);c.remainingUtc=-30;Test.assert(SceneAod.countdownColor(c,settings)==settings.countdownColor);c.remainingUtc=null;Test.assert(SceneAod.countdownColor(c,settings)==0xA3ADB8);
 var renderer=new SceneRenderer(null);renderer.prepare(null,settings);var values={"steps"=>0,"energy"=>null,"heart"=>null,"stress"=>null};var first=new CueTrace();c.rescheduled=false;c.stale=false;renderer.active(first,c,settings,values,new Fitness(),0.0f);var next=new CueTrace();c.rescheduled=true;renderer.active(next,c,settings,values,new Fitness(),0.0f);Test.assertMessage(next.lines==first.lines+6,"reschedule must draw the six-stroke marker in actual ACTIVE renderer");
 renderer.prepareAod();var low0=new CueTrace();c.rescheduled=false;c.stale=true;renderer.aod(low0,c,0l,settings);Test.assert(low0.dots>0);var low1=new CueTrace();c.rescheduled=true;renderer.aod(low1,c,0l,settings);Test.assert(low1.lines==low0.lines+6&&low1.dots>0);var low2=new CueTrace();renderer.aod(low2,c,1l,settings);Test.assert(low2.firstX==low1.firstX+2);c.stale=false;c.rescheduled=false;c.sourceHold=true;var held=new CueTrace();renderer.aod(held,c,0l,settings);Test.assertMessage(held.lines==2&&held.dots==0,"hold pause mark must remain separate from stale dots");c.rescheduled=true;var both=new CueTrace();renderer.aod(both,c,0l,settings);Test.assert(both.lines==8&&both.dots==0);
 logger.debug("COUNTDOWN_CUES delta=86400,86399,0,-30,null active_low_marker=6 stale_dots=true hold_marker=2 aod_shift=2");return true;
}
(:test,:typecheck(false)) function stepsGeneratedLifecycle(logger){
 var count=0;var applied=0;var hiddenEvents=0;var resumes=0;
 for(var seed=1;seed<=12;seed+=1){var v=new MenuView();var f=new IncidentFields();var api=new StepsApi();f.api=api;v.selectedFields=f;var fit=new StepsFitness();fit.selectedFields=f;v.fitness=fit;v.values={"steps"=>0,"energy"=>null,"heart"=>null,"stress"=>null};v.onShow();f.start(v.settings.slots,v.method(:fieldsChanged));var shown=true;var expected=0;var current=null;var rng=seed;
  for(var i=0;i<48;i+=1){rng=(rng*73+19)%997;var e=rng%5;if(e==0){current=(rng%4==0)?null:rng%101;api.currentStep=current;}else if(e==1){v.fieldsChanged(new Complications.Id(2));if(shown){expected=current==null?fit.current:current;applied+=1;}else{hiddenEvents+=1;}}else if(e==2){v.onHide();shown=false;}else if(e==3){if(!shown){v.onShow();shown=true;v.readFitnessSnapshot(1794818604l);expected=current==null?fit.current:current;resumes+=1;}}else{var old=api.stepReads;v.onUpdate(new MenuDraw());Test.assert(api.stepReads==old);}
   Test.assertMessage(v.values["steps"]==expected,"independent steps model seed="+seed+" event="+i+" kind="+e);count+=1;
  }v.onHide();
 }Test.assert(applied>0&&hiddenEvents>0&&resumes>0);logger.debug("STEPS_GENERATED seeds=12 events="+count+" callbacks="+applied+" hidden="+hiddenEvents+" resumes="+resumes+" after_each=true");return true;
}
(:test,:typecheck(false)) function stepsCountdownBatch(logger){peerStepsReadOwnership(logger);peerFallbackCues(logger);selectedStepsCallback(logger);countdownCues(logger);stepsGeneratedLifecycle(logger);var sdk=new SelectedFields();try{var iter=sdk.historySamples(23);var sample=iter==null?null:iter.next();var now=Time.now().value();var stamp=sample==null||sample.when==null?null:sample.when.value();var admitted=sample==null?null:HealthSample.recentValue(sample.data,stamp,now,100,false);logger.debug("BODY_BATTERY_SDK iterator="+(iter!=null)+" sample="+(sample!=null)+" data_present="+(sample!=null&&sample.data!=null)+" age="+(stamp==null?"unknown":(now-stamp).toString())+" accepted="+(admitted!=null));}catch(e){logger.debug("BODY_BATTERY_SDK unavailable=true");}return true;}

(:test,:typecheck(false)) function peerStepsReadOwnership(logger){
 var fields=new StepsFields();var api=new StepsApi();fields.api=api;fields.start(["steps","custom2","heart","stress"],fields.method(:callback));var fit=new StepsFitness();fit.selectedFields=fields;fit.selectedRoles=["steps"];
 api.currentStep=42;fields.read("en");var before=fit.calls;var values=fit.sample(1794818604l);Test.assertMessage(values["steps"]==42&&fit.calls==before,"valid current steps must not read ActivityMonitor during full sample");
 api.currentStep=0;fields.readChanged("en",new Complications.Id(2));values=fit.sample(1794818604l);Test.assert(values["steps"]==0&&fit.calls==before);
 api.currentStep=null;fit.current=7;fields.readChanged("en",new Complications.Id(2));values=fit.sample(1794818604l);Test.assert(values["steps"]==7&&fit.calls==before+1);
 api.currentStep=42;fields.readChanged("en",new Complications.Id(2));fit.selectedRoles=["steps","calories"];before=fit.calls;values=fit.sample(1794818604l);Test.assert(values["steps"]==42&&values["calories"]==90&&fit.calls==before+1);
 api.currentStep=null;fields.readChanged("en",new Complications.Id(2));before=fit.calls;values=fit.sample(1794818604l);Test.assert(values["steps"]==7&&values["calories"]==90&&fit.calls==before+1);
 api.currentStep=0;fields.readChanged("en",new Complications.Id(2));fit.failActivity=true;before=fit.calls;values=fit.sample(1794818604l);Test.assert(values["steps"]==0&&fit.fieldState("steps").equals("READY")&&fit.fieldState("calories").equals("UNAVAILABLE")&&fit.calls==before+1);fields.stop();
 logger.debug("PEER_STEPS_READ current_and_zero_skip=true missing_fallback_once=true calories_shared_read=true independent_error=true");return true;
}
(:test,:typecheck(false)) function peerFallbackCues(logger){
 var view=new MenuView();view.context=new SceneContext({"id"=>"simulated:launch","rocket"=>"Falcon 9","operator"=>"SpaceX","site"=>"US","modelId"=>"ll2:configuration:80","precision"=>"exact","target"=>1794818704,"displayTarget"=>1794818704});view.onShow();
 for(var mode=0;mode<2;mode+=1){view.mode=mode==0?System.DISPLAY_MODE_HIGH_POWER:System.DISPLAY_MODE_LOW_POWER;view.syncDisplayMode(view.mode);view.context.stale=false;view.context.sourceHold=false;view.context.rescheduled=false;var baseline=new CueTrace();view.drawClockFallback(baseline);view.context.stale=true;var stale=new CueTrace();view.drawClockFallback(stale);Test.assertMessage(stale.dots>baseline.dots&&stale.lines==baseline.lines,"fallback stale must keep dots without hold/reschedule glyphs");
 view.context.stale=false;view.context.sourceHold=true;var held=new CueTrace();view.drawClockFallback(held);Test.assert(held.dots==baseline.dots&&held.lines==baseline.lines+2);
 view.context.rescheduled=true;var both=new CueTrace();view.drawClockFallback(both);Test.assert(both.dots==baseline.dots&&both.lines==baseline.lines+8);}
 view.onHide();logger.debug("PEER_FALLBACK_CUES active_low stale_dots_only=true hold2=true both8=true");return true;
}
