import Toybox.Application;
import Toybox.Graphics;
import Toybox.Lang;
import Toybox.System;
import Toybox.Test;
import Toybox.Time;

(:test,:typecheck(false)) class SelectedDrawing extends SceneRenderer {
 var logger;var label;var rows=[];var dots=0;
 function initialize(log,name){SceneRenderer.initialize(null);logger=log;label=name;}
 function text(dc as Graphics.Dc,x as Numeric,y as Numeric,font as Graphics.FontType,value as String,color as Number,width as Number,contour as Number) as String {var shown=SceneRenderer.text(dc,x,y,font,value,color,width,contour);rows.add([x,y,shown,color,contour]);logger.debug("SCENE_TEXT|"+label+"|"+x+"|"+y+"|"+dc.getTextWidthInPixels(shown,font)+"|"+dc.getFontHeight(font)+"|"+color+"|"+contour+"|"+shown);return shown;}
 function underline(dc,x,y,width,color){dots+=1;SceneRenderer.underline(dc,x,y,width,color);}
 function at(y){for(var i=0;i<rows.size();i+=1){if(rows[i][1]==y){return rows[i];}}return null;}
}
(:typecheck(false)) function selectedCanvas(){return Graphics.createBufferedBitmap({:width=>390,:height=>390}).get();}
(:typecheck(false)) function selectedRender(log,label,c,snapshot){var d=new SelectedDrawing(log,label);d.prepare(c,new SceneSettings(null));var image=selectedCanvas();d.active(image.getDc(),snapshot,new SceneSettings(null),{},new Fitness(),0.0);return d;}
(:test,:typecheck(false)) function selectedHeaderPositive(logger){var c=selectedContext(0);var d=selectedRender(logger,"current",c,new ClockSnapshot("08:08","02:00:00"));return c.rocket.equals("Vulcan VC6L")&&c.operator.equals("United Launch Alliance")&&c.purpose.equals("Communications")&&d.at(43)!=null&&d.at(47)!=null&&d.at(70)[2].equals("Communications")&&d.at(319)!=null;}
(:test,:typecheck(false)) function selectedHeaderNegative(logger){for(var i=1;i<5;i+=1){var c=selectedContext(i);var rocket=c.rocket;var operator=c.operator;var site=c.site;var d=selectedRender(logger,"long"+i,c,new ClockSnapshot("08:08","02:00:00"));if(!c.rocket.equals(rocket)||!c.operator.equals(operator)||!c.site.equals(site)||d.at(319)==null){return false;}if(i==4&&(!c.purpose.equals("")||!d.at(70)[2].equals("—"))){return false;}}var absent=new SceneContext({"id"=>selectedContext(0).launchId});var d=selectedRender(logger,"absent",absent,new ClockSnapshot("08:08","--:--:--"));return absent.operator.equals("")&&absent.purpose.equals("")&&d.at(47)[2].equals("—")&&d.at(70)[2].equals("—");}
(:test,:typecheck(false)) function selectedModelPositive(logger){var ids=["falcon-9","electron","ariane-62"];var origins=["US","NZ","EUROPE"];var d=new SceneRenderer(null);var prior=null;for(var i=0;i<3;i+=1){var c=selectedKnownContext(i);c.modelId=ids[i];d.prepare(c,new SceneSettings(null));if(d.art==null||d.model==prior||!d.model.origin.equals(origins[i])||!d.fullContext.rocket.equals(c.rocket)){return false;}prior=d.model;}logger.debug("actual bundled resources change for sourced Falcon9/Electron/Ariane62 text; native aliases are technical mappings, not display names");return true;}
(:test,:typecheck(false)) function selectedModelNegative(logger){var c=selectedContext(0);var d=new SceneRenderer(null);d.prepare(c,new SceneSettings(null));var retained=c.rocket;c.modelId="ll2:configuration:999999999";d.prepare(c,new SceneSettings(null));var v=new SpaceFoxView(new WatchClock(),new ScheduleState(null,"unknown"));v.setContext(selectedKnownContext(0));v.downloaded=new NativeSfrRenderer();v.setContext(c);logger.debug("unmapped exact typed configuration is generic; new context drops previous downloaded bitmap and labels atomically");return d.model==NativeAssets.models["generic"]&&d.country==null&&d.company==null&&c.rocket.equals(retained)&&v.context==c&&v.downloaded==null;}
(:test,:typecheck(false)) function selectedGeographyPositive(logger){var p=selectedPacket();var s=new NativeStore();var b=new NativeSfrBuild(s,"https://selected-scene.invalid",p);var d=b.prepareRole("map");logger.debug("actual native root/catalog association source point accepted; decoded map canvas390x390");return b.scene["position"]==true&&nativeSame(d["canvas"],[390,390]);}
(:test,:typecheck(false)) function selectedGeographyNegative(logger){var p=selectedPacket();p.bridge["site"]["position"]["longitude"]="-80.58313644";var refused=false;try{new NativeSfrBuild(new NativeStore(),"https://selected-scene.invalid",p);}catch(ex){refused=true;}var c=selectedContext(0);var d=new SceneRenderer(null);var invalid=[null,[181,0],[0,-91],["0",0],[0]];for(var i=0;i<invalid.size();i+=1){c.point=invalid[i];var clean=new SceneContext({"id"=>c.launchId,"rocket"=>c.rocket,"site"=>c.site,"point"=>invalid[i]});d.prepare(clean,new SceneSettings(null));if(d.pin||!clean.site.equals(c.site)){return false;}}logger.debug("mismatched corrected source/root coordinate rejects; absent/invalid points retain real site text without old pin");return refused;}
(:test,:typecheck(false)) function selectedIdentityPositive(logger){var p=selectedPacket();var b=new NativeSfrBuild(new NativeStore(),"https://selected-scene.invalid",p);var d=b.prepareRole("rocket");logger.debug("actual accepted typed launch/model/operator/site/country root identity and rocket descriptor54x124");return nativeSame(d["canvas"],[54,124])&&b.result.selectionHash.equals(selectedSelectionHash());}
(:test,:typecheck(false)) function selectedIdentityNegative(logger){for(var i=0;i<5;i+=1){var p=selectedPacket();p.bridge["ids"][i]=null;var failed=false;try{new NativeSfrBuild(new NativeStore(),"https://selected-scene.invalid",p);}catch(ex){failed=true;}if(!failed){return false;}}var p=selectedPacket();var b=new NativeSfrBuild(new NativeStore(),"https://selected-scene.invalid",p);b.scene["roles"]["rocket"]["entityId"]=p.bridge["ids"][2];try{b.prepareRole("rocket");return false;}catch(ex){}logger.debug("all5 typed root identity mismatches and wrong role owner refuse; cannot relabel cached image");return true;}
(:test,:typecheck(false)) function selectedCompositionPositive(logger){var d=new SceneRenderer(null);var image=selectedCanvas();var dc=image.getDc();var c=selectedContext(0);d.prepare(c,new SceneSettings(null));var before=d.resourceLoads;for(var i=0;i<3;i+=1){d.active(dc,new ClockSnapshot("08:08","02:00:00"),new SceneSettings(null),{},new Fitness(),0.0);}logger.debug("actual native circle/font/resources and3redraws reuse; no background or map substituted");return dc.getFontHeight(d.fonts["label"])>=21&&dc.getFontHeight(d.fonts["metric"])>=32&&d.resourceLoads==before&&d.marker.getWidth()==28&&d.marker.getHeight()==28;}
(:test,:typecheck(false)) function selectedStatusPositive(logger){for(var r=0;r<2;r+=1){for(var s=0;s<2;s+=1){var c=selectedContext(0);c.rescheduled=r==1;c.stale=s==1;var d=selectedRender(logger,"state"+r+s,c,new ClockSnapshot("08:08","02:00:00"));if(d.at(202)[3]!=(r==1?0xF3C37A:0x71E4C0)||d.at(120)[3]!=0x7FE7C6||d.dots!=s||d.rows.size()!=12){return false;}}}logger.debug("actual draw calls all4independent status combinations: amber/mint, dotted underline only stale, unchanged time, no service row");return true;}
(:test,:typecheck(false)) function selectedStatusNegative(logger){var c=selectedContext(0);c.rescheduled=true;c.stale=true;c.schedule=new ScheduleState(null,"unknown");var snap=new ClockSnapshot("08:08",c.schedule.display(1794572010,true));var d=selectedRender(logger,"unknown",c,snap);if(!d.at(202)[2].equals("--:--:--")||d.at(202)[3]!=0xF3C37A||d.dots!=1){return false;}var v=new SpaceFoxView(new WatchClock(),new ScheduleState(null,"unknown"));v.setContext(c);var different=selectedKnownContext(1);v.setContext(different);var clean=selectedRender(logger,"different",different,new ClockSnapshot("08:08","00:00:00"));logger.debug("unknown time never precise; new actual identity drops status flags; zero has no liftoff state");return !different.rescheduled&&!different.stale&&clean.dots==0&&clean.at(202)[3]==0x71E4C0&&v.context==different;}
