(:test,:typecheck(false)) function currentWideRecovery(logger){var s=new CurrentStore();var c=currentCache(s);Test.assert(new NativeJson().byteSize(CurrentFixture.wide())==8192);Test.assert(c.accept(CurrentFixture.wide(),1794551192l));var seal=c.commit["seal"];var raw=c.commit["rawHash"];c=null;c=new TestNativeCache("https://current-native.invalid",s);Test.assert(c.load(1794551192l)!=null&&c.commit["seal"].equals(seal));var t=new NativeTransfer(c.base,s);Test.assert(t.stage("feed",CurrentFixture.wide()+"x",null)==false);Test.assert(t.stage("feed",CurrentFixture.wide()+"!",null)==false);Test.assert(t.stage("feed",CurrentFixture.wide(),null));var incoming=new TestNativeIncoming(s,c.base);Test.assert(incoming.admitFeed(c,1794551192l));Test.assert(c.commit["seal"].equals(seal));Test.assert(c.accept(CurrentFixture.fresh(),1794554792l));Test.assert(c.commit["rawHash"].equals(raw));c=null;c=new TestNativeCache("https://current-native.invalid",s);Test.assert(c.load(1794554792l)!=null&&c.packet.validation==1794554792l);logger.debug("CURRENT_WIDE exact8192=true coldWarmReopen=true sourceOnlyRawReuse=true");return true;}
(:test,:typecheck(false)) function currentSourceAge(logger){var s=new CurrentStore();var c=currentCache(s);Test.assert(c.accept(CurrentFixture.feed(),1794551192l));var age=c.packet.validation;var cutoff=age+c.packet.document["refreshPolicy"]["normal_interval_seconds"]*c.packet.document["refreshPolicy"]["stale_cycles"];c.packet.advance(cutoff);Test.assert(c.packet.stale&&c.packet.validation==age);c.attempted(1794551192l);Test.assert(!c.due(1794551192l));Test.assert(c.due(1794558392l));Test.assert(!c.accept(CurrentFixture.feed().substring(0,20),1794558392l));Test.assert(c.packet.validation==age);logger.debug("CURRENT_AGE failedNetworkDoesNotRenew=true staleFromSource=true cadence=true");return true;}
(:test,:typecheck(false)) function currentAtomicRecovery(logger){for(var fault=1;fault<=10;fault+=1){var s=new CurrentStore();var c=currentCache(s);Test.assert(c.accept(CurrentFixture.wide(),1794551192l));var seal=c.commit["seal"];s.failAt=s.writes+fault;var accepted=c.accept(CurrentFixture.changed(),1794554792l);s.failAt=-1;if(!accepted){Test.assert(c.restoreAccepted(1794554792l,seal)!=null&&c.commit["seal"].equals(seal));}else{Test.assert(c.packet.document["publisher"]["generation"]==3);}var reopened=new TestNativeCache(c.base,s);Test.assert(reopened.load(1794554792l)!=null);}logger.debug("CURRENT_ATOMIC writeInterruptions=10 lastGoodRecoverable=true");return true;}
